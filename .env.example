# Copy to .env (git-ignored; never commit it) and fill in. Names as python/launcher/launch.py reads them.
# Load in a bash shell with:  set -a; source .env; set +a
# (PowerShell: Get-Content .env | ? {$_ -match '^[A-Z]'} | % { $n,$v = $_ -split '=',2; Set-Item "env:$n" $v })

# vast.ai (renting, status, destroying)
VAST_API_KEY=

# Cloudflare R2 (run files, stored inputs at inputs/sha256/<hex>, release binaries at bin/<sha>/)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
